{
  "name": "@thecodecodex/tools",
  "version": "0.1.0",
  "description": "Lógica das ferramentas do thecodecodex.com (finanças BR, CPF/CNPJ, PDF, regex, JWT e mais) e o script de terminal cli.js",
  "license": "MIT",
  "author": "Douglas Capeletti",
  "homepage": "https://thecodecodex.com/pt/tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglas-capeletti/thecodecodex-tools.git"
  },
  "bugs": "https://github.com/douglas-capeletti/thecodecodex-tools/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./random": "./src/random/index.ts",
    "./table-convert": "./src/table-convert/index.ts",
    "./skills.json": "./src/skills.json",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fixture.*",
    "!src/**/fixtures",
    "!src/test-setup.ts"
  ],
  "scripts": {
    "check": "tsc && eslint && vitest run",
    "test": "vitest run",
    "lint": "eslint",
    "skills:build": "node scripts/build-skills.mjs",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
